# tpt-identity configuration
# Copy to config.yaml and edit before running.

# The canonical URL of this identity provider (used as OIDC issuer and DID:web base)
issuer: "https://identity.example.com"

# Path to the SQLite database file
db_path: "tpt-identity.db"

# HTTP server address
listen_addr: ":8080"

# Bearer token for the admin/API endpoints. Required: the server refuses to start without it.
api_key: "change-me-to-a-long-random-string"

# HMAC key for bridge (external login) state tokens. Use a separate random value of at
# least 32 bytes. Required when running more than one replica; if unset, a random key is
# generated at startup and in-flight bridge logins fail after a restart.
# bridge_secret: "change-me-to-a-different-long-random-string"

# Rate limiting — requests per second per IP (0 = use default 50 req/s)
rate_limit: 0

identity:
  # Path to the Ed25519 private key PEM file (generated by `tpt-identity keygen`)
  signing_key: "ed25519.pem"
  # Path to the X25519 private key PEM file (optional, for encryption support)
  enc_key: "x25519.pem"
  # Passphrase used to decrypt the key files (leave empty if keys are unencrypted)
  passphrase: ""
  # Verification method ID in the DID document (default: <issuer>#signing-key-1)
  key_id: ""

# DID:web configuration
did_web:
  enabled: true
  domain: "identity.example.com"

# OIDC token lifetimes
oidc:
  id_token_ttl: "1h"
  access_token_ttl: "1h"
  code_ttl: "5m"
  refresh_token_ttl: "720h" # 30 days

# ── Identity Bridge configuration ────────────────────────────────────────────

# TOTP encryption passphrase (defaults to identity.passphrase if not set)
totp_passphrase: ""

# OIDC relying-party bridges — add one entry per upstream provider.
# Supported: Google, GitHub, Azure AD, Okta, any OIDC-compliant IdP.
bridges:
  oidc:
    - name: "google"
      issuer: "https://accounts.google.com"
      client_id: "your-google-client-id.apps.googleusercontent.com"
      client_secret: "your-google-client-secret"
      scopes: ["openid", "email", "profile"]

    # - name: "github"
    #   issuer: "https://token.actions.githubusercontent.com"
    #   client_id: "your-github-client-id"
    #   client_secret: "your-github-client-secret"
    #   scopes: ["openid", "user:email"]

    # - name: "azure-ad"
    #   issuer: "https://login.microsoftonline.com/{tenant-id}/v2.0"
    #   client_id: "your-azure-app-client-id"
    #   client_secret: "your-azure-client-secret"
    #   scopes: ["openid", "email", "profile"]

  # Magic link (email OTP) is always enabled.
  # Configure an SMTP relay to actually send the emails (tpt-email integration planned).

  # Password bridge — legacy opt-in. Not recommended; use passkeys or magic links.
  password:
    enabled: false

# SAML bridge (requires build tag: go build -tags saml ./...)
# saml_idps:
#   - name: "saml:acme-corp"
#     idp_metadata_url: "https://sso.acme.com/metadata"
#     entity_id: "https://identity.example.com"
#     cert_file: "saml-sp.crt"
#     key_file: "saml-sp.key"

# LDAP bridge (requires build tag: go build -tags ldap ./...)
# ldap:
#   url: "ldaps://ldap.example.com:636"
#   bind_dn: "CN=svc-tpt,OU=ServiceAccounts,DC=example,DC=com"
#   bind_password: "service-account-password"
#   user_base_dn: "OU=Users,DC=example,DC=com"
#   user_filter: "(sAMAccountName=%s)"

# Logging
log:
  level: "info"   # debug, info, warn, error
  format: "json"  # json or text
